{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ecommerce.db"
  },
  "Jwt": {
    "Issuer": "ecommerce-api",
    "Audience": "ecommerce-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "BcryptWorkFactor": 12,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Seed": {
    "DemoData": false
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPerMinute": 10,
    "RecommendPerMinute": 20,
    "GlobalPerMinute": 240
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Recommendations": {
    "MaxResults": 5,
    "MaxCatalogItems": 500,
    "Gemini": {
      "Enabled": false,
      "Model": "gemini-2.5-flash",
      "BaseUrl": "https://generativelanguage.googleapis.com/",
      "MaxCandidates": 40,
      "CacheMinutes": 5,
      "TimeoutSeconds": 8,
      "CircuitBreakerMinimumRequests": 10,
      "CircuitBreakerSeconds": 30
    }
  }
}
