# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# 32+ random characters, e.g.  openssl rand -base64 48
JWT_SIGNING_KEY=

# Optional bootstrap administrator (both or neither). Password: 10+ chars with upper, lower and a digit.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Browser origin of the admin app
ADMIN_ORIGIN=http://localhost:5173
